# ============================================================
# SteamPipe 配置 —— 填好这 3 个 Depot ID 才能上传
# ============================================================
# 如何找到 Depot ID:
#   1. 打开 https://partner.steamgames.com/apps/5327410/edit/depots
#   2. 点进每个 depot,网址末尾的数字就是 Depot ID
#      例如 .../depots/5327411  →  Depot ID = 5327411
#   3. 如果还没建 depot,点"添加新 Depot",平台分别选
#      Windows / macOS / Linux,建完再回来填
#
# 惯例上第一个 depot 往往是 AppID+1,但不要假设,照着后台抄。

APP_ID=5327410
DEPOT_WINDOWS=
DEPOT_MAC=
DEPOT_LINUX=
